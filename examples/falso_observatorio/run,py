"""Script de ejecución del Falso Observatorio.

Amarra la simulación de Stokes y la reconstrucción de RM utilizando
el algoritmo de fuerza bruta para resolver la ambigüedad n-pi.
"""

import time
import numpy as np
import matplotlib.pyplot as plt

# Importaciones del framework FaradayMR
from faradaymr.analysis.rm_fit import resolve_n_pi_ambiguity

# Importaciones locales del falso observatorio
import examples.falso_observatorio.config as cfg
from examples.falso_observatorio.model import construir_mapa_rm_analitico, observar_stokes_qu


def main():
    print("1. Construyendo mapa de RM analítico (Verdad)...")
    rm_verdad = construir_mapa_rm_analitico()

    print("2. Simulando observaciones del radiotelescopio (Stokes Q/U)...")
    # mapas_psi_obs tiene dimensiones (3, N_PIXELES, N_PIXELES)
    mapas_Q, mapas_U, mapas_psi_obs = observar_stokes_qu(rm_verdad)

    print("3. Reconstruyendo RM píxel por píxel resolviendo la ambigüedad n-pi...")
    start_time = time.time()
    
    # Preasignar el mapa recuperado
    rm_recuperado = np.zeros_like(rm_verdad)
    longitudes_onda = cfg.LONGITUDES_ONDA_M
    
    # Iteramos sobre cada píxel de la malla 2D
    for i in range(cfg.N_PIXELES):
        for j in range(cfg.N_PIXELES):
            # Extraer la curva de rotación observada para este píxel en las 3 frecuencias
            psi_pixel = mapas_psi_obs[:, i, j]
            
            # Reconstruir aplicando la fuerza bruta
            rm_estimado = resolve_n_pi_ambiguity(
                longitudes_onda, 
                psi_pixel, 
                n_candidatos=range(-3, 4)
            )
            rm_recuperado[i, j] = rm_estimado
            
    print(f"   Reconstrucción completada en {time.time() - start_time:.2f} segundos.")

    print("4. Calculando errores...")
    error_absoluto = np.abs(rm_recuperado - rm_verdad)
    error_maximo = np.max(error_absoluto)
    print(f"   Error máximo de reconstrucción: {error_maximo:.4e} rad/m^2")

    print("5. Generando visualización...")
    fig, axes = plt.subplots(1, 3, figsize=(15, 5))

    im0 = axes[0].imshow(rm_verdad, origin='lower', cmap='viridis')
    axes[0].set_title("RM Verdad Analítica")
    fig.colorbar(im0, ax=axes[0], fraction=0.046, pad=0.04)

    im1 = axes[1].imshow(rm_recuperado, origin='lower', cmap='viridis')
    axes[1].set_title("RM Reconstruido (resolve_n_pi)")
    fig.colorbar(im1, ax=axes[1], fraction=0.046, pad=0.04)

    im2 = axes[2].imshow(error_absoluto, origin='lower', cmap='inferno')
    axes[2].set_title("Error Absoluto")
    fig.colorbar(im2, ax=axes[2], fraction=0.046, pad=0.04)

    plt.tight_layout()
    plt.show()


if __name__ == "__main__":
    main()